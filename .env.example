# Server Configuration
HTTP_PORT=5000
GRPC_PORT=50051

# Nomad Configuration
NOMAD_ADDR=http://localhost:4646

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/control_plane?sslmode=disable

# JWT Secret (REQUIRED - minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-very-secure-secret-key-at-least-32-characters-long-please-change-this

# Bootstrap API Key (optional - creates admin API key on first run)
BOOTSTRAP_KEY=admin-bootstrap
